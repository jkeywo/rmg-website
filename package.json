{
  "name": "reading-megagames-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node tools/serve-site.mjs",
    "package": "node tools/package-site.mjs --environment production",
    "package:staging": "node tools/package-site.mjs --environment staging",
    "build": "npm run package",
    "build:staging": "npm run package:staging",
    "test": "node --test",
    "check": "node tools/check-site.mjs dist"
  }
}
